// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Calendar {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#3b82f6")
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  color       String    @default("#3b82f6")
  isAllDay    Boolean   @default(false)

  // Calendar reference
  calendarId  String
  calendar    Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  // Recurrence
  recurrenceRule String?   // RRULE format or JSON string
  recurrenceEndDate DateTime?

  // For recurring event instances
  parentEventId String?
  parentEvent   Event?    @relation("RecurringEvents", fields: [parentEventId], references: [id], onDelete: Cascade)
  instances     Event[]   @relation("RecurringEvents")

  // Exception dates (dates to skip in recurrence)
  exceptionDates String?  // JSON array of dates

  // Reminder
  reminderMinutes Int?    // Minutes before event to remind

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Chat conversations
model Conversation {
  id          String       @id @default(uuid())
  title       String       @default("Nova conversa")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  messages    Message[]
  daySession  DaySession[]  // Relação com sessões de acompanhamento
}

model Message {
  id             String       @id @default(uuid())
  role           String       // 'user' or 'assistant'
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Pending actions stored as JSON
  pendingActions String?      // JSON array of actions

  createdAt      DateTime     @default(now())
}

// User settings (stored in DB instead of localStorage)
model UserSettings {
  id                  String   @id @default("default")
  personalContext     String   @default("") // Immutable personal context
  generalOrientations String   @default("")
  bookSummaries       String   @default("[]") // JSON array
  timeContexts        String   @default("{}") // JSON object
  updatedAt           DateTime @updatedAt
}

// Day Tracker - Sessão de acompanhamento do dia
model DaySession {
  id             String       @id @default(uuid())
  date           DateTime     // Qual dia está sendo acompanhado
  status         String       @default("active") // 'active' | 'completed'

  // Conversa do acompanhamento
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // Relatório gerado
  report         DayReport?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Relatório do dia
model DayReport {
  id             String     @id @default(uuid())
  daySessionId   String     @unique
  daySession     DaySession @relation(fields: [daySessionId], references: [id], onDelete: Cascade)

  // Conteúdo do relatório
  summary        String     // Resumo geral do dia
  completedTasks String     @default("[]") // JSON array - o que foi feito
  skippedTasks   String     @default("[]") // JSON array - o que pulou
  highlights     String     @default("[]") // JSON array - momentos positivos
  challenges     String     @default("[]") // JSON array - dificuldades
  insights       String     @default("[]") // JSON array - aprendizados/insights

  // Métricas
  plannedEvents    Int      @default(0)
  completedEvents  Int      @default(0)
  completionRate   Float    @default(0) // 0-100
  energyLevel      Int?     // 1-5 auto-avaliação
  moodRating       Int?     // 1-5 auto-avaliação

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}
