generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Calendar {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#3b82f6")
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

model Event {
  id                String    @id @default(uuid())
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  color             String    @default("#3b82f6")
  isAllDay          Boolean   @default(false)
  calendarId        String
  recurrenceRule    String?
  recurrenceEndDate DateTime?
  parentEventId     String?
  exceptionDates    String?
  reminderMinutes   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  parentEvent       Event?    @relation("RecurringEvents", fields: [parentEventId], references: [id], onDelete: Cascade)
  instances         Event[]   @relation("RecurringEvents")
  calendar          Calendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
}

model Conversation {
  id         String       @id @default(uuid())
  title      String       @default("Nova conversa")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  daySession DaySession[]
  messages   Message[]
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  conversationId String
  pendingActions String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                     String   @id @default("default")

  // AI Settings
  geminiModel            String   @default("gemini-2.5-flash")
  aiEnabled              Boolean  @default(true)

  // Mentor Orientations
  generalOrientations    String   @default("")

  // Calendar Settings
  weekStartsOn           Int      @default(0)
  defaultView            String   @default("week")
  defaultEventDuration   Int      @default(60)
  defaultReminderMinutes Int?     @default(15)

  // Appearance
  theme                  String   @default("system")
  compactMode            Boolean  @default(false)
  showWeekNumbers        Boolean  @default(false)

  // Notifications
  enableNotifications    Boolean  @default(true)
  soundEnabled           Boolean  @default(true)

  // Time format
  use24HourFormat        Boolean  @default(true)

  // Working hours
  workingHoursStart      Int      @default(9)
  workingHoursEnd        Int      @default(18)
  workingDays            String   @default("[1,2,3,4,5]")

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  memories               Memory[]
  bookReferences         BookReference[]
  timeContexts           TimeContext[]
}

model Memory {
  id             String       @id @default(uuid())
  content        String
  userSettingsId String       @default("default")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userSettings   UserSettings @relation(fields: [userSettingsId], references: [id], onDelete: Cascade)
}

model BookReference {
  id             String       @id @default(uuid())
  title          String
  topics         String       @default("")
  enabled        Boolean      @default(true)
  userSettingsId String       @default("default")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userSettings   UserSettings @relation(fields: [userSettingsId], references: [id], onDelete: Cascade)
}

model TimeContext {
  id             String       @id @default(uuid())
  type           String       // weekly, monthly, quarterly, sixMonth, yearly
  content        String       @default("")
  contentUpdatedAt DateTime?  // when content was last updated (for countdown)
  userSettingsId String       @default("default")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userSettings   UserSettings @relation(fields: [userSettingsId], references: [id], onDelete: Cascade)

  @@unique([userSettingsId, type])
}

model DaySession {
  id             String        @id @default(uuid())
  date           DateTime
  status         String        @default("active")
  conversationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  report         DayReport?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
}

model DayReport {
  id              String     @id @default(uuid())
  daySessionId    String     @unique
  summary         String
  completedTasks  String     @default("[]")
  skippedTasks    String     @default("[]")
  highlights      String     @default("[]")
  challenges      String     @default("[]")
  insights        String     @default("[]")
  plannedEvents   Int        @default(0)
  completedEvents Int        @default(0)
  completionRate  Float      @default(0)
  energyLevel     Int?
  moodRating      Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  daySession      DaySession @relation(fields: [daySessionId], references: [id], onDelete: Cascade)
}

model Todo {
  id               String    @id @default(uuid())
  content          String    // Original user input
  priority         String    @default("medium") // urgent, high, medium, low
  status           String    @default("pending") // pending, completed, cancelled
  deadline         DateTime?
  estimatedMinutes Int?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
